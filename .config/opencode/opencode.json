{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@0.2.2",
    "opencodex-fast@0.1.1",
    "opencode-claude-auth@v1.5.0"
  ],
  "agent": {
    "gpt-opinion": {
      "variant": "high"
    },
    "claude-opinion": {
      "variant": "xhigh"
    }
  },
  "permission": {
    "read": {
      "/Users/liamaharon/.cargo/registry/**": "allow",
      "/Users/liamaharon/.cargo/git/**": "allow"
    },
    "glob": {
      "/Users/liamaharon/.cargo/registry/**": "allow",
      "/Users/liamaharon/.cargo/git/**": "allow"
    },
    "grep": {
      "/Users/liamaharon/.cargo/registry/**": "allow",
      "/Users/liamaharon/.cargo/git/**": "allow"
    },
    "list": {
      "/Users/liamaharon/.cargo/registry/**": "allow",
      "/Users/liamaharon/.cargo/git/**": "allow"
    },
    "external_directory": {
      "/Users/liamaharon/.cargo/registry/**": "allow",
      "/Users/liamaharon/.cargo/git/**": "allow",
      "/Users/liamaharon/grimoire/gammafront/**": "allow"
    },
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "head*": "allow",
      "cargo*": "allow",
      "crunch*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr status*": "allow",
      "gh pr checkout*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue status*": "allow",
      "gh repo view*": "allow",
      "gh release view*": "allow",
      "gh release list*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh run watch*": "allow",
      "gh workflow view*": "allow",
      "gh workflow list*": "allow",
      "gh search*": "allow",
      "gh label list*": "allow",
      "gh gist view*": "allow",
      "gh gist list*": "allow",
      "gh auth status*": "allow",
      "gh browse*": "allow",
      "git add*": "allow",
      "git fetch origin*": "allow",
      "git status*": "allow",
      "git branch --show-current*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git remote -v*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git ls-files*": "allow",
      "git blame*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push --force-with-lease*": "ask",
      "git push --delete*": "ask",
      "git push --mirror*": "ask",
      "git push --prune*": "ask",
      "git push * :*": "ask"
    }
  }
}
